<?xml version="1.0" encoding="utf-8"?>
<!--
  Home Assistant is usually reached over plain HTTP on the LAN (e.g. http://192.168.1.10:8123).
  The host is user-configurable and may be an IP address, so cleartext can't be limited with a
  <domain-config> (which has no IP wildcards). HTTPS is still verified against the system CAs, and a
  self-signed certificate is accepted only for one configured host with a pinned SHA-256 fingerprint
  (see WebViewHost.onReceivedSslError).
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
