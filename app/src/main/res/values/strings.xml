    <!-- Kiosk lock -->
    <string name="settings_section_kiosk">Kiosk lock</string>
    <string name="kiosk_not_owner">Keeps the dashboard in front: no status bar, notifications, Home or other apps. It needs the app to be device owner, set up once from a PC with adb; see the setup guide. Without it, everything else works as usual.</string>
    <string name="kiosk_state_off">This app is device owner. Kiosk lock is off: the tablet works like a normal tablet.</string>
    <string name="kiosk_state_on">Kiosk lock is on; it starts when the dashboard is shown.</string>
    <string name="kiosk_state_active">Kiosk lock is on: only the dashboard can be used. The power button menu still works.</string>
    <string name="kiosk_state_unlocked">Kiosk lock is on but temporarily unlocked.</string>
    <string name="kiosk_state_still_locked">The lock could not be released yet. Go back to the dashboard and open Settings again; if it persists, see the setup guide (ways back).</string>
    <string name="kiosk_unlocked_until">Locks again at %1$s.</string>
    <string name="kiosk_lock">Kiosk lock</string>
    <string name="kiosk_lock_help">Stays as you set it, also after restarts. Home Assistant can’t switch it off.</string>
    <string name="kiosk_needs_pin">Set a PIN under Settings protection first; the kiosk lock needs one.</string>
    <string name="kiosk_unlock">Unlock for 15 minutes</string>
    <string name="kiosk_relock">Lock now</string>
    <string name="kiosk_open_android_settings">Open Android settings</string>
    <string name="kiosk_locked_hint">While locked, Android screens (permissions, battery, Wi-Fi) can’t open. Unlock for 15 minutes first. Opening Android settings unlocks for 15 minutes.</string>
    <string name="kiosk_remove_owner">Remove device owner permanently</string>
    <string name="kiosk_remove_owner_help">Turns the tablet back into a normal tablet. The app stays installed; the kiosk lock can only return after setting up device owner again from a PC.</string>
    <string name="kiosk_remove_owner_confirm">The kiosk lock is switched off and the app stops being device owner. Setting it up again needs adb and a tablet without accounts. Continue?</string>
    <string name="kiosk_remove_owner_yes">Remove</string>
    <string name="pin_remove_unlocks_kiosk">The kiosk lock needs a PIN, so removing the PIN also switches the kiosk lock off. Continue?</string>

