    <!-- Settings protection (PIN) -->
    <string name="settings_section_protection">Settings protection</string>
    <string name="protection_no_pin_notice">No PIN is set, so anyone at the panel can open Settings with 5 quick taps in the top-right corner. Setting a PIN is recommended.</string>
    <string name="protection_pin_set">Settings are protected by a PIN.</string>
    <string name="protection_set_pin">Set PIN</string>
    <string name="protection_change_pin">Change PIN</string>
    <string name="protection_remove_pin">Remove PIN</string>
    <string name="protection_help">4–8 digits. Forgot it? See the setup guide: an adb command removes it, or clear the app’s data in Android settings.</string>
