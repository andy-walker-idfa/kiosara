    <!-- Kiosk lock -->
    <string name="settings_section_kiosk">Zámek kiosku</string>
    <string name="kiosk_not_owner">Drží dashboard v popředí: bez stavového řádku, oznámení, tlačítka Domů a jiných aplikací. Aplikace k tomu musí být vlastníkem zařízení, což se jednou nastaví z počítače přes adb; viz průvodce nastavením. Bez toho vše ostatní funguje jako obvykle.</string>
    <string name="kiosk_state_off">Tato aplikace je vlastníkem zařízení. Zámek kiosku je vypnutý: tablet funguje jako běžný tablet.</string>
    <string name="kiosk_state_on">Zámek kiosku je zapnutý; začne platit, až se zobrazí dashboard.</string>
    <string name="kiosk_state_active">Zámek kiosku je zapnutý: lze používat jen dashboard. Nabídka tlačítka napájení funguje dál.</string>
    <string name="kiosk_state_unlocked">Zámek kiosku je zapnutý, ale dočasně odemčený.</string>
    <string name="kiosk_state_still_locked">Zámek se zatím nepodařilo uvolnit. Vraťte se na dashboard a znovu otevřete nastavení; pokud to trvá, viz průvodce nastavením (cesty zpět).</string>
    <string name="kiosk_unlocked_until">Znovu se zamkne v %1$s.</string>
    <string name="kiosk_lock">Zámek kiosku</string>
    <string name="kiosk_lock_help">Zůstane, jak ho nastavíte, i po restartu. Home Assistant ho vypnout nemůže.</string>
    <string name="kiosk_needs_pin">Nejdřív nastavte PIN v části Ochrana nastavení; zámek kiosku ho vyžaduje.</string>
    <string name="kiosk_unlock">Odemknout na 15 minut</string>
    <string name="kiosk_relock">Zamknout hned</string>
    <string name="kiosk_open_android_settings">Otevřít nastavení Androidu</string>
    <string name="kiosk_locked_hint">Když je zamčeno, obrazovky Androidu (oprávnění, baterie, Wi-Fi) se neotevřou. Nejdřív odemkněte na 15 minut. Otevření nastavení Androidu odemkne na 15 minut.</string>
    <string name="kiosk_remove_owner">Trvale odebrat vlastníka zařízení</string>
    <string name="kiosk_remove_owner_help">Vrátí tablet do běžného stavu. Aplikace zůstane nainstalovaná; zámek kiosku se vrátí jen po novém nastavení vlastníka zařízení z počítače.</string>
    <string name="kiosk_remove_owner_confirm">Zámek kiosku se vypne a aplikace přestane být vlastníkem zařízení. Nové nastavení vyžaduje adb a tablet bez účtů. Pokračovat?</string>
    <string name="kiosk_remove_owner_yes">Odebrat</string>
    <string name="pin_remove_unlocks_kiosk">Zámek kiosku vyžaduje PIN, takže odebráním PINu se vypne i zámek kiosku. Pokračovat?</string>

